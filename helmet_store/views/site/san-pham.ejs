<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <link rel="shortcut icon" href="/img/favicon.ico" />

    <title>Helmet Store</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta content="eCommerce HTML Template Free Download" name="keywords" />
    <meta content="eCommerce HTML Template Free Download" name="description" />

    <!-- Favicon -->
    <link rel="shortcut icon" href="/img/favicon.ico" />
    <!-- Google Fonts -->
    <link
      href="https://fonts.googleapis.com/css?family=Open+Sans:300,400|Source+Code+Pro:700,900&display=swap"
      rel="stylesheet"
    />

    <!-- CSS Libraries -->
    <link
      href="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css"
      rel="stylesheet"
    />
    <link href="../lib/slick/slick.css" rel="stylesheet" />
    <link href="../lib/slick/slick-theme.css" rel="stylesheet" />

    <!-- Template Stylesheet -->
    <link href="../css/style.css" rel="stylesheet" />
  </head>

  <body>
    <% if (typeof slug !== 'function') { var slug = function(name) { if (!name) return ''; return String(name) .normalize('NFD') .replace(/[\u0300-\u036f]/g, '') .replace(/đ/g, 'd') .replace(/Đ/g, 'd') .toLowerCase() .replace(/\s+/g, '-'); }; } %>
    
    <!-- Top bar Start -->
    <div class="top-bar">
      <div class="container-fluid">
        <div class="row">
          <div class="col-sm-6">
            <i class="fa fa-envelope"></i> tranhuy@.com
          </div>
          <div class="col-sm-6">
            <i class="fa fa-phone-alt"></i> +01234567890
          </div>
        </div>
      </div>
    </div>
    <!-- Top bar End -->

    <!-- Nav Bar Start -->
    <div class="nav">
      <div class="container-fluid">
        <nav class="navbar navbar-expand-md bg-dark navbar-dark">
          <a href="#" class="navbar-brand">MENU</a>
          <button
            type="button"
            class="navbar-toggler"
            data-toggle="collapse"
            data-target="#navbarCollapse"
          >
            <span class="navbar-toggler-icon"></span>
          </button>

          <div
            class="collapse navbar-collapse justify-content-between"
            id="navbarCollapse"
          >
            <div class="navbar-nav mr-auto">
              <a href="/" class="nav-item nav-link">Trang Chủ</a>
              <a href="/san-pham" class="nav-item nav-link active">Sản Phẩm</a>
              <!-- <a href="product-detail.html" class="nav-item nav-link">Product Detail</a> -->
              <a href="/cart" class="nav-item nav-link">Giỏ Hàng</a>
              <a href="/thanh-toan" class="nav-item nav-link">Thanh Toán</a>
              <a href="/users/tai-khoan" class="nav-item nav-link"
                >Tài khoản của bạn</a
              >
              <div class="nav-item dropdown">
                <a
                  href="#"
                  class="nav-link dropdown-toggle"
                  data-toggle="dropdown"
                  >Trang khác</a
                >
                <div class="dropdown-menu">
                  <a href="/wishlist" class="dropdown-item"
                    >Sản phẩm đã thích</a
                  >
                  <a href="/lien-he" class="dropdown-item">Liên hệ</a>
                </div>
              </div>
            </div>
            <div class="navbar-nav ml-auto">
              <% if (user) { %>
              <div class="nav-item dropdown">
                <a
                  href="#"
                  class="nav-link dropdown-toggle"
                  data-toggle="dropdown"
                  ><i class="fa fa-user"></i> <%= user.nameUser %></a
                >
                <div class="dropdown-menu">
                  <a href="/users/tai-khoan" class="dropdown-item"
                    >Tài khoản của tôi</a
                  >
                  <a href="/orders" class="dropdown-item">Đơn hàng</a>
                  <a href="/users/dang-xuat" class="dropdown-item">Đăng xuất</a>
                </div>
              </div>
              <% } else { %>
              <div class="nav-item dropdown">
                <a
                  href="#"
                  class="nav-link dropdown-toggle"
                  data-toggle="dropdown"
                  >Tài khoản</a
                >
                <div class="dropdown-menu">
                  <a href="/users/dang-nhap" class="dropdown-item">Đăng nhập</a>
                  <a href="/users/dang-ky" class="dropdown-item">Đăng ký</a>
                </div>
              </div>
              <% } %>
            </div>
          </div>
        </nav>
      </div>
    </div>
    <!-- Nav Bar End -->

    <!-- Bottom Bar Start -->
    <div class="bottom-bar">
      <div class="container-fluid">
        <div class="row align-items-center">
          <div class="col-md-3">
            <div class="logo">
              <a href="/">
                <img src="../img/logo.png" alt="Logo" />
              </a>
            </div>
          </div>
          <div class="col-md-6">
            <div class="search">
              <input type="text" placeholder="Search" />
              <button><i class="fa fa-search"></i></button>
            </div>
          </div>
          <div class="col-md-3">
            <div class="user">
              <a href="/wishlist" class="btn wishlist">
                <i class="fa fa-heart"></i>
                <span>(<%= wishlistCount || 0 %>)</span>
              </a>
              <a href="/cart" class="btn cart">
                <i class="fa fa-shopping-cart"></i>
                <span>(<%= cartCount || 0 %>)</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Bottom Bar End -->

    <!-- Breadcrumb Start -->
    <div class="breadcrumb-wrap">
      <div class="container-fluid">
        <ul class="breadcrumb">
          <li class="breadcrumb-item"><a href="#">Home</a></li>
          <li class="breadcrumb-item"><a href="#">Sản phẩm</a></li>
          <li class="breadcrumb-item active"><%=breadcrumb%></li>
        </ul>
      </div>
    </div>
    <!-- Breadcrumb End -->

    <!-- Product List Start -->
    <div class="product-view">
      <div class="container-fluid">
        <div class="row">
          <div class="col-lg-8">
            <div class="row">
              <div class="col-md-12">
                <div class="product-view-top">
                  <div class="row">
                    <div class="col-md-4">
                      <div class="product-search">
                        <input
                          id="myInput"
                          type="email"
                          placeholder="Tìm kiếm tên sản phẩm"
                          autocomplete="off"
                        />
                        <button><i class="fa fa-search"></i></button>
                      </div>
                    </div>
                    <div class="col-md-4">
                      <div class="product-short">
                        <div class="dropdown">
                          <div class="dropdown-toggle" data-toggle="dropdown">
                            <%= currentSort === 'asc' ? 'Giá tăng dần': currentSort === 'desc' ? 'Giá giảm dần' : 'Sắp xếp theo giá' %>
                          </div>
                          <div class="dropdown-menu dropdown-menu-right">
                            <a
                              href="/san-pham?<%= currentPriceRange ? 'priceRange=' + currentPriceRange + '&' : '' %>sort=asc"
                              class="dropdown-item"
                              >Giá tăng dần</a
                            >
                            <a
                              href="/san-pham?<%= currentPriceRange ? 'priceRange=' + currentPriceRange + '&' : '' %>sort=desc"
                              class="dropdown-item"
                              >Giá giảm dần</a
                            >
                            <% if (currentSort) { %>
                            <a
                              href="/san-pham?<%= currentPriceRange ? 'priceRange=' + currentPriceRange : '' %>"
                              class="dropdown-item text-danger"
                              >Bỏ sắp xếp</a
                            >
                            <% } %>
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="col-md-4">
                      <div class="product-price-range">
                        <div class="dropdown">
                          <div class="dropdown-toggle" data-toggle="dropdown">
                            <%= currentPriceRange ? 'Đã chọn khoảng giá' : 'Lọc theo giá' %>
                          </div>
                          <div class="dropdown-menu dropdown-menu-right">
                            <a
                              href="/san-pham?priceRange=0-500000<%= currentSort ? '&sort=' + currentSort : '' %>"
                              class="dropdown-item"
                              >0 ₫ - 500.000 ₫</a
                            >
                            <a
                              href="/san-pham?priceRange=500000-1000000<%= currentSort ? '&sort=' + currentSort : '' %>"
                              class="dropdown-item"
                              >500.000 ₫ - 1.000.000 ₫</a
                            >
                            <a
                              href="/san-pham?priceRange=1000000-2000000<%= currentSort ? '&sort=' + currentSort : '' %>"
                              class="dropdown-item"
                              >1.000.000 ₫ - 2.000.000 ₫</a
                            >
                            <a
                              href="/san-pham?priceRange=2000000-5000000<%= currentSort ? '&sort=' + currentSort : '' %>"
                              class="dropdown-item"
                              >2.000.000 ₫ - 5.000.000 ₫</a
                            >
                            <a
                              href="/san-pham?priceRange=5000000-up<%= currentSort ? '&sort=' + currentSort : '' %>"
                              class="dropdown-item"
                              >Trên 5.000.000 ₫</a
                            >
                            <% if (currentPriceRange) { %>
                            <a
                              href="/san-pham?<%= currentSort ? 'sort=' + currentSort : '' %>"
                              class="dropdown-item text-danger"
                              >Bỏ lọc giá</a
                            >
                            <% } %>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <% if (currentPriceRange || currentSort) { %>
              <div class="col-md-12 mb-3">
                <div
                  class="alert alert-info d-flex justify-content-between align-items-center"
                  style="margin: 0"
                >
                  <span>
                    <i class="fa fa-filter"></i> <strong>Bộ lọc:</strong>
                    <% if (currentPriceRange) { %>
                    <span class="badge badge-primary ml-2">
                      Khoảng giá: <% if (currentPriceRange === '0-500000') { %> 0₫ - 500.000 ₫ <% } %> <% if (currentPriceRange === '500000-1000000') { %>500.000 ₫ - 1.000.000 ₫<% } %> <% if (currentPriceRange === '1000000-2000000') { %>1.000.000 ₫ - 2.000.000 ₫<% } %> <% if (currentPriceRange === '2000000-5000000') { %>2.000.000 ₫ - 5.000.000 ₫<% } %>
                      <%if (currentPriceRange === '5000000-up') { %>Trên 5.000.000 ₫<% } %>
                    </span>
                    <% } %> <% if (currentSort) { %>
                    <span class="badge badge-success ml-2">
                      <%= currentSort === 'asc' ? '▲ Giá tăng dần' : '▼ Giá giảm dần' %>
                    </span>
                    <% } %>
                  </span>
                  <a href="/san-pham" class="btn btn-sm btn-warning">
                    <i class="fa fa-times"></i> Xóa bộ lọc
                  </a>
                </div>
              </div>
              <% } %>

              <div class="col-md-12">
                <div id="myTable" class="row">
                  <% for (product of listPro) { %>
                    <div class="col-md-4">
                      <div class="product-item">
                        <div class="product-title">
                          <a href="/san-pham/<%= slug(product.nameProduct) %>"><%=product.nameProduct%></a>
                          <div class="ratting">
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                          </div>
                        </div>
                        <div class="product-image">
                          <a href="/san-pham/<%= slug(product.nameProduct) %>">
                            <img src="../<%=product.imgProduct%>" alt="Product Image" />
                          </a>
                          <div class="product-action" data-product-id="<%=product.idProduct%>">
                            <a href="#" class="add-to-cart" data-product-id="<%=product.idProduct%>"
                              ><i class="fa fa-cart-plus"></i
                            ></a>
                            <a
                              href="#"
                              class="add-to-wishlist <%= userWishlistIds && userWishlistIds.includes(product.idProduct) ? 'active' : '' %>"
                              data-product-id="<%=product.idProduct%>"
                              title="<%= userWishlistIds && userWishlistIds.includes(product.idProduct) ? 'Bỏ thích' : 'Yêu thích' %>"
                              ><i class="<%= userWishlistIds && userWishlistIds.includes(product.idProduct) ? 'fas' : 'far' %> fa-heart"></i
                            ></a>
                            <a class="slug" href="/san-pham/<%= slug(product.nameProduct) %>"
                              ><i class="fa fa-search"></i
                            ></a>
                          </div>
                        </div>
                        <div class="product-price">
                          <h3><%=product.priceProduct.toLocaleString('vi-VN')%><span> ₫</span></h3>
                          <a
                            class="btn add-to-cart"
                            href="#"
                            data-product-id="<%=product.idProduct%>"
                            ><i class="fa fa-shopping-cart"></i>Mua Ngay</a
                          >
                        </div>
                      </div>
                    </div>
                  <% } %>
                </div>
              </div>
              
              <!-- Thông báo không tìm thấy sản phẩm -->
              <div class="col-md-12">
                <div id="noResultMessage" class="text-center" style="display: none; padding: 40px 0;">
                  <i class="fa fa-search" style="font-size: 48px; color: #ccc; margin-bottom: 20px; display: block;"></i>
                  <h3 style="color: #666; margin: 20px 0;">Không tìm thấy sản phẩm phù hợp</h3>
                  <p style="color: #999; margin: 10px 0;">Vui lòng thử lại với từ khóa khác</p>
                </div>
              </div>
            </div>

            <!-- Pagination Start -->
            <div class="col-md-12">
              <nav aria-label="Page navigation example">
                <ul class="pagination justify-content-center">
                  <li class="page-item disabled">
                    <a class="page-link" href="#" tabindex="-1">Previous</a>
                  </li>
                  <li class="page-item active">
                    <a class="page-link" href="#">1</a>
                  </li>
                  <li class="page-item"><a class="page-link" href="#">2</a></li>
                  <li class="page-item"><a class="page-link" href="#">3</a></li>
                  <li class="page-item">
                    <a class="page-link" href="#">Next</a>
                  </li>
                </ul>
              </nav>
            </div>
            <!-- Pagination Start -->
          </div>

          <!-- Side Bar Start -->
          <div class="col-lg-4 sidebar">
            <div class="sidebar-widget category">
              <h2 class="title">Danh mục</h2>
              <nav class="navbar bg-light">
                <ul class="navbar-nav">
                  <% for (cat of listCat) { %>
                  <li class="nav-item">
                    <a class="nav-link" href="/danh-muc/<%=cat.nameCat%>"
                      ><i class="fa fa-motorcycle"></i>Nón Fullface <%=cat.nameCat %></a
                    >
                  </li>
                  <% } %>
                </ul>
              </nav>
            </div>

            <div class="sidebar-widget widget-slider">
              <h3 style="text-align: center; color: #ff6f61">Nón Nổi Bật</h3>
              <div class="sidebar-slider normal-slider">
                <% for (product of listProPopular) { %>
                <div class="product-item">
                  <div class="product-title">
                    <a href="#"> <%=product.nameProduct%> </a>
                    <div class="ratting">
                      <i class="fa fa-star"></i>
                      <i class="fa fa-star"></i>
                      <i class="fa fa-star"></i>
                      <i class="fa fa-star"></i>
                      <i class="fa fa-star"></i>
                    </div>
                  </div>
                  <div class="product-image">
                    <a href="/san-pham/<%= slug(product.nameProduct) %>">
                      <img
                        src="../<%=product.imgProduct%>"
                        alt="Product Image"
                      />
                    </a>
                    <div class="product-action">
                      <a
                        href="#"
                        class="add-to-cart"
                        data-product-id="<%=product.idProduct%>"
                        title="Thêm vào giỏ"
                        ><i class="fa fa-cart-plus"></i
                      ></a>
                      <a
                        href="#"
                        class="add-to-wishlist"
                        data-product-id="<%=product.idProduct%>"
                        title="<%= userWishlistIds && userWishlistIds.includes(product.idProduct) ? 'Bỏ thích' : 'Yêu thích' %>"
                        ><i class="<%= userWishlistIds && userWishlistIds.includes(product.idProduct) ? 'fas' : 'far' %> fa-heart"></i
                      ></a>
                      <a
                        class="slug"
                        href="/san-pham/<%= slug(product.nameProduct) %>"
                        title="Xem chi tiết"
                        ><i class="fa fa-search"></i
                      ></a>
                    </div>
                  </div>
                  <div class="product-price">
                    <h3>
                      <%=product.priceProduct.toLocaleString('vi-VN')%>
                      <span>₫</span>
                    </h3>
                    <a
                      class="btn add-to-cart"
                      href="#"
                      data-product-id="<%=product.idProduct%>"
                      ><i class="fa fa-shopping-cart"></i>Mua Ngay</a
                    >
                  </div>
                </div>
                <% } %>
              </div>
            </div>


          </div>
          <!-- Side Bar End -->
        </div>
      </div>
    </div>
    <!-- Product List End -->

    <!-- Brand Start -->
    <div class="brand">
      <div class="container-fluid">
        <div class="brand-slider">
          <div class="brand-item">
            <a href="/danh-muc/agv"><img src="../img/brand-1.png" alt="" /></a>
          </div>
          <div class="brand-item">
            <a href="/danh-muc/shoei"
              ><img src="../img/brand-2.png" alt=""
            /></a>
          </div>
          <div class="brand-item">
            <a href="/danh-muc/arai"><img src="../img/brand-3.png" alt="" /></a>
          </div>
          <div class="brand-item">
            <a href="/danh-muc/torc"><img src="../img/brand-4.png" alt="" /></a>
          </div>
          <div class="brand-item">
            <a href="/danh-muc/yohe"><img src="../img/brand-5.png" alt="" /></a>
          </div>
          <div class="brand-item">
            <a href="/danh-muc/kyt"><img src="../img/brand-6.png" alt="" /></a>
          </div>
          <div class="brand-item">
            <a href="/danh-muc/royal"
              ><img src="../img/brand-7.png" alt=""
            /></a>
          </div>
          <div class="brand-item">
            <a href="/danh-muc/ls2"><img src="../img/brand-8.png" alt="" /></a>
          </div>
        </div>
      </div>
    </div>
    <!-- Brand End -->

    <!-- Footer Start -->
    <div class="footer">
      <div class="container-fluid">
        <div class="row">
          <div class="col-lg-3 col-md-6">
            <div class="footer-widget">
              <h2>Liên Hệ</h2>
              <div class="contact-info">
                <p><i class="fa fa-map-marker"></i>Từ Liêm, Hà Nội, Việt Nam</p>
                <p><i class="fa fa-envelope"></i>quanghuytxc@gmail.com</p>
                <p><i class="fa fa-phone"></i>+01234567890</p>
              </div>
            </div>
          </div>

          <div class="col-lg-3 col-md-6">
            <div class="footer-widget">
              <h2>Theo Dõi Tôi</h2>
              <div class="contact-info">
                <div class="social">
                  <a href=""><i class="fab fa-twitter"></i></a>
                  <a href="https://www.facebook.com/ybx1802"
                    ><i class="fab fa-facebook-f"></i
                  ></a>
                  <a href="https://www.linkedin.com/in/huy-tran-57777b202/"
                    ><i class="fab fa-linkedin-in"></i
                  ></a>
                  <a href="#"><i class="fab fa-instagram"></i></a>
                  <a href="#"><i class="fab fa-youtube"></i></a>
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-3 col-md-6">
            <div class="footer-widget">
              <h2>Thông Tin Cửa Hàng</h2>
              <ul>
                <li><a href="#">Giới thiệu</a></li>
                <li><a href="#">Chính sách bảo mật</a></li>
                <li><a href="#">Hình thức vận chuyển</a></li>
              </ul>
            </div>
          </div>

          <div class="col-lg-3 col-md-6">
            <div class="footer-widget">
              <h2>Thông Tin Mua Hàng</h2>
              <ul>
                <li><a href="#">Chính sách thanh toán</a></li>
                <li><a href="#">Chính sách vận chuyển</a></li>
                <li><a href="#">Chính sách hoàn trả</a></li>
              </ul>
            </div>
          </div>
        </div>

        <div class="row payment align-items-center">
          <div class="col-md-6">
            <div class="payment-method">
              <h2>Nhận thanh toán bằng:</h2>
              <img src="../img/payment-method.png" alt="Payment Method" />
            </div>
          </div>
          <div class="col-md-6">
            <div class="payment-security">
              <h2>Chứng chỉ bảo mật:</h2>
              <img src="../img/godaddy.svg" alt="Payment Security" />
              <img src="../img/norton.svg" alt="Payment Security" />
              <img src="../img/ssl.svg" alt="Payment Security" />
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Footer End -->

    <!-- Footer Bottom Start -->
    <div class="footer-bottom">
      <div class="container">
        <div class="row">
          <div class="col-md-6 copyright">
            <p>
              Copyright &copy;
              <a href="https://www.facebook.com/tran.huy.928441">Helmet Store</a
              >. All Rights Reserved
            </p>
          </div>
        </div>
      </div>
    </div>
    <!-- Footer Bottom End -->

    <!-- Back to Top -->
    <a href="#" class="back-to-top"><i class="fa fa-chevron-up"></i></a>

    <!-- JavaScript Libraries -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.bundle.min.js"></script>
    <script src="../lib/easing/easing.min.js"></script>
    <script src="../lib/slick/slick.min.js"></script>

    <!-- Template Javascript -->
    <script src="../js/main.js"></script>
  </body>
</html>

<script>
  // Search Product with no result message
  $(document).ready(function () {
    // Đợi DOM render xong hoàn toàn
    setTimeout(function() {
      console.log("=== san-pham.ejs Initialized ===");
      console.log("Total products:", $("#myTable .col-md-4").length);
      console.log("noResultMessage exists:", $("#noResultMessage").length > 0);
      
      // Function để kiểm tra và hiển thị thông báo
      function checkNoResults() {
        var totalProducts = $("#myTable .col-md-4").length;
        var visibleProducts = $("#myTable .col-md-4:visible").length;
        console.log("=== Check No Results ===");
        console.log("Total:", totalProducts);
        console.log("Visible:", visibleProducts);
        
        if (totalProducts === 0) {
          console.log("WARNING: No products in page!");
          $("#noResultMessage").css("display", "block").show();
          return;
        }
        
        if (visibleProducts === 0) {
          console.log("✓ SHOWING no result message");
          $("#noResultMessage").css("display", "block").show();
        } else {
          console.log("✓ Hiding no result message");
          $("#noResultMessage").hide();
        }
      }
      
      // Search functionality cho ô tìm kiếm trên
      $(".bottom-bar .search input").on("keyup", function () {
        var value = $(this).val().toLowerCase().trim();
        console.log("=== Search triggered (bottom-bar) ===");
        console.log("Search value:", value);
        
        $("#myTable .col-md-4").filter(function () {
          var isMatch = value === '' || $(this).text().toLowerCase().indexOf(value) > -1;
          $(this).toggle(isMatch);
        });
        
        setTimeout(checkNoResults, 50);
      });
      
      // Search functionality cho ô tìm kiếm trong product-view-top
      $("#myInput").on("keyup", function () {
        var value = $(this).val().toLowerCase().trim();
        console.log("=== Search triggered (#myInput) ===");
        console.log("Search value:", value);
        
        $("#myTable .col-md-4").filter(function () {
          var isMatch = value === '' || $(this).text().toLowerCase().indexOf(value) > -1;
          $(this).toggle(isMatch);
        });
        
        setTimeout(checkNoResults, 50);
      });
      
      // Kiểm tra URL có search parameter không
      var urlParams = new URLSearchParams(window.location.search);
      var searchParam = urlParams.get('search');
      if (searchParam) {
        $("#myInput").val(searchParam);
        $("#myInput").trigger("keyup");
      }
    }, 100);
  });
</script>
