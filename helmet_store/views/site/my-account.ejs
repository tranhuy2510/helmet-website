    <!-- Template Javascript -->
    <script src="../js/main.js"></script>
    <script>
      // Global variable to track edit mode
      let isEditMode = false;
      let currentEditId = null;

      function setDefaultAddress(addressId) {
        if (confirm("Đặt địa chỉ này làm mặc định?")) {
          $.ajax({
            url: "/users/set-default-address",
            method: "POST",
            data: { addressId: addressId },
            success: function (response) {
              if (response.success) {
                alert("Đã đặt làm địa chỉ mặc định!");
                location.reload();
              } else {
                alert(response.message || "Có lỗi xảy ra");
              }
            },
            error: function () {
              alert("Có lỗi xảy ra khi cập nhật địa chỉ mặc định");
            },
          });
        }
      }

      function deleteAddress(addressId) {
        if (confirm("Bạn có chắc muốn xóa địa chỉ này?")) {
          $.ajax({
            url: "/users/delete-address",
            method: "POST",
            data: { addressId: addressId },
            success: function (response) {
              if (response.success) {
                alert("Đã xóa địa chỉ!");
                location.reload();
              } else {
                alert(response.message || "Có lỗi xảy ra");
              }
            },
            error: function () {
              alert("Có lỗi xảy ra khi xóa địa chỉ");
            },
          });
        }
      }

      function editAddress(
        id,
        fullName,
        phone,
        province,
        district,
        ward,
        detailAddress
      ) {
        console.log("Edit address called with:", {
          id,
          fullName,
          phone,
          province,
          district,
          ward,
          detailAddress,
        });

        // Set edit mode
        isEditMode = true;
        currentEditId = id;

        // Update modal title
        $("#editAddressModalLabel").text("Chỉnh Sửa Địa Chỉ Nhận Hàng");

        // Populate form with existing data
        $('#editAddressModal input[name="fullName"]').val(fullName);
        $('#editAddressModal input[name="phone"]').val(phone);
        $('#editAddressModal select[name="province"]').val(province);
        $('#editAddressModal input[name="district"]').val(district);
        $('#editAddressModal input[name="ward"]').val(ward);
        $('#editAddressModal textarea[name="detailAddress"]').val(
          detailAddress
        );

        // Show modal
        $("#editAddressModal").modal("show");
      }

      // Handle form submission
      $(document).ready(function () {
        $("#editAddressModal form").on("submit", function (e) {
          e.preventDefault();

          const formData = {
            fullName: $('input[name="fullName"]').val(),
            phone: $('input[name="phone"]').val(),
            province: $('select[name="province"]').val(),
            district: $('input[name="district"]').val(),
            ward: $('input[name="ward"]').val(),
            detailAddress: $('textarea[name="detailAddress"]').val(),
          };

          console.log("Form submitted with data:", formData);
          console.log("Edit mode:", isEditMode, "Edit ID:", currentEditId);

          if (isEditMode && currentEditId) {
            // Update existing address
            formData.id = currentEditId;

            console.log("Sending PUT request with data:", formData);

            $.ajax({
              url: "/users/update-address",
              method: "PUT",
              data: formData,
              success: function (response) {
                console.log("PUT request success:", response);
                alert("Cập nhật địa chỉ thành công!");
                $("#editAddressModal").modal("hide");
                location.reload();
              },
              error: function (xhr) {
                console.error("PUT request error:", xhr);
                console.error("Error details:", {
                  status: xhr.status,
                  statusText: xhr.statusText,
                  responseText: xhr.responseText,
                  response: xhr.responseJSON,
                });
                alert(
                  "Có lỗi xảy ra khi cập nhật địa chỉ! Chi tiết: " +
                    (xhr.responseJSON?.message || xhr.statusText)
                );
              },
            });
          } else {
            // Create new address (original behavior)
            formData.setAsDefault = $('input[name="setAsDefault"]').is(
              ":checked"
            )
              ? "1"
              : "0";
            formData.addressType = "home";

            console.log("Sending POST request with data:", formData);

            $.ajax({
              url: "/users/update-address",
              method: "POST",
              data: formData,
              success: function (response) {
                console.log("POST request success:", response);
                alert("Thêm địa chỉ mới thành công!");
                $("#editAddressModal").modal("hide");
                location.reload();
              },
              error: function (xhr) {
                console.error("POST request error:", xhr);
                alert("Có lỗi xảy ra khi thêm địa chỉ mới!");
              },
            });
          }
        });

        // Reset form when modal is closed
        $("#editAddressModal").on("hidden.bs.modal", function () {
          isEditMode = false;
          currentEditId = null;
          $("#editAddressModalLabel").text("Thêm Địa Chỉ Nhận Hàng");
          this.querySelector("form").reset();
        });
      });

      // Xem chi tiết đơn hàng
      function viewOrderDetails(orderId) {
        // Chuyển đến trang chi tiết đơn hàng
        window.location.href = `/orders/${orderId}`;
      }

      // Hủy đơn hàng
      function cancelOrder(orderId) {
        if (confirm("Bạn có chắc muốn hủy đơn hàng này không?")) {
          const reason = prompt(
            "Vui lòng cho biết lý do hủy đơn hàng:",
            "Thay đổi ý định mua hàng"
          );

          if (reason === null) return; // User clicked Cancel

          $.ajax({
            url: `/orders/cancel/${orderId}`,
            method: "POST",
            data: { reason: reason || "Khách hàng hủy" },
            success: function (response) {
              if (response.success) {
                alert("✅ " + response.message);
                location.reload();
              } else {
                alert("❌ " + response.message);
              }
            },
            error: function () {
              alert("Có lỗi khi hủy đơn hàng");
            },
          });
        }
      }
    </script>
  </body>
