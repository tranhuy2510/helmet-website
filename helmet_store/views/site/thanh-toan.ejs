        <div class="row">
          <div class="col-sm-6">
            <i class="fa fa-envelope"></i> tranhuy@.com
          </div>
          <div class="col-sm-6">
            <i class="fa fa-phone-alt"></i> +01234567890
          </div>
        </div>
      </div>
    </div>
    <!-- Top bar End -->

    <!-- Nav Bar Start -->
    <div class="nav">
      <div class="container-fluid">
        <nav class="navbar navbar-expand-md bg-dark navbar-dark">
          <a href="#" class="navbar-brand">MENU</a>
          <button
            type="button"
            class="navbar-toggler"
            data-toggle="collapse"
            data-target="#navbarCollapse"
          >
            <span class="navbar-toggler-icon"></span>
          </button>

          <div
            class="collapse navbar-collapse justify-content-between"
            id="navbarCollapse"
          >
            <div class="navbar-nav mr-auto">
              <a href="/" class="nav-item nav-link">Trang Chủ</a>
              <a href="/san-pham" class="nav-item nav-link">Sản Phẩm</a>
              <!-- <a href="product-detail.html" class="nav-item nav-link">Product Detail</a> -->
              <a href="/cart" class="nav-item nav-link">Giỏ Hàng</a>
              <a href="/thanh-toan" class="nav-item nav-link active"
                >Thanh Toán</a
              >
              <a href="/users/tai-khoan" class="nav-item nav-link"
                >Tài khoản của bạn</a
              >
              <div class="nav-item dropdown">
                <a
                  href="#"
                  class="nav-link dropdown-toggle"
                  data-toggle="dropdown"
                  >Trang khác</a
                >
                <div class="dropdown-menu">
                  <a href="/wishlist" class="dropdown-item"
                    >Sản phẩm đã thích</a
                  >
                  <a href="/lien-he" class="dropdown-item">Liên hệ</a>
                </div>
              </div>
            </div>
            <div class="navbar-nav ml-auto">
              <% if (user) { %>
              <div class="nav-item dropdown">
                <a
                  href="#"
                  class="nav-link dropdown-toggle"
                  data-toggle="dropdown"
                  ><i class="fa fa-user"></i> <%= user.nameUser %></a
                >
                <div class="dropdown-menu">
                  <a href="/users/tai-khoan" class="dropdown-item"
                    >Tài khoản của tôi</a
                  >
                  <a href="/orders" class="dropdown-item">Đơn hàng</a>
                  <a href="/users/dang-xuat" class="dropdown-item">Đăng xuất</a>
                </div>
              </div>
              <% } else { %>
              <div class="nav-item dropdown">
                <a
                  href="#"
                  class="nav-link dropdown-toggle"
                  data-toggle="dropdown"
                  >Tài khoản</a
                >
                <div class="dropdown-menu">
                  <a href="/users/dang-nhap" class="dropdown-item">Đăng nhập</a>
                  <a href="/users/dang-ky" class="dropdown-item">Đăng ký</a>
                </div>
              </div>
              <% } %>
            </div>
          </div>
        </nav>
      </div>
    </div>
    <!-- Nav Bar End -->

    <!-- Bottom Bar Start -->
    <div class="bottom-bar">
      <div class="container-fluid">
        <div class="row align-items-center">
          <div class="col-md-3">
            <div class="logo">
              <a href="/">
                <img src="img/logo.png" alt="Logo" />
              </a>
            </div>
          </div>
          <div class="col-md-6">
            <div class="search">
              <input type="text" placeholder="Search" />
              <button><i class="fa fa-search"></i></button>
            </div>
          </div>
          <div class="col-md-3">
            <div class="user">
              <a href="/wishlist" class="btn wishlist">
                <i class="fa fa-heart"></i>
                <span>(<%= wishlistCount || 0 %>)</span>
              </a>
              <a href="/cart" class="btn cart">
                <i class="fa fa-shopping-cart"></i>
                <span>(<%= cartCount || 0 %>)</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Bottom Bar End -->

    <!-- Breadcrumb Start -->
    <div class="breadcrumb-wrap">
      <div class="container-fluid">
        <ul class="breadcrumb">
          <li class="breadcrumb-item"><a href="/">Home</a></li>
          <li class="breadcrumb-item"><a href="/san-pham">Products</a></li>
          <li class="breadcrumb-item active">Checkout</li>
        </ul>
      </div>
    </div>
    <!-- Breadcrumb End -->

    <!-- Checkout Start -->
    <div class="checkout">
      <div class="container-fluid">
        <div class="row">
          <div class="col-lg-8">
            <div class="checkout-inner">
              <div class="billing-address">
                <h2>Thông Tin Đặt Hàng</h2>

                <!-- Button để load địa chỉ mặc định -->
                <% if (user) { %>
                <div class="row mb-3">
                  <div class="col-md-12">
                    <button
                      type="button"
                      class="btn btn-outline-primary"
                      onclick="loadDefaultAddress()"
                    >
                      <i class="fa fa-address-book"></i> Sử dụng địa chỉ mặc
                      định
                    </button>
                  </div>
                </div>
                <% } %>

                <form id="checkoutForm">
                  <div class="row">
                    <div class="col-md-6">
                      <input
                        class="form-control"
                        type="text"
                        placeholder="Họ"
                        id="firstName"
                        name="firstName"
                        value="<%= user ? user.ho : '' %>"
                        required
                      />
                    </div>
                    <div class="col-md-6">
                      <input
                        class="form-control"
                        type="text"
                        placeholder="Tên"
                        id="lastName"
                        name="lastName"
                        value="<%= user ? user.ten : '' %>"
                        required
                      />
                    </div>
                    <div class="col-md-6">
                      <input
                        class="form-control"
                        type="email"
                        placeholder="E-mail"
                        id="email"
                        name="email"
                        value="<%= user ? user.email : '' %>"
                        required
                      />
                    </div>
                    <div class="col-md-6">
                      <input
                        class="form-control"
                        type="tel"
                        placeholder="Số điện thoại"
                        id="phone"
                        name="phone"
                        value="<%= user ? user.phone || '' : '' %>"
                        required
                      />
                    </div>
                    <div class="col-md-12">
                      <textarea
                        class="form-control"
                        placeholder="Địa chỉ giao hàng chi tiết"
                        id="shippingAddress"
                        name="shippingAddress"
                        rows="3"
                        required
                      >
<%= user ? user.address || '' : '' %></textarea
                      >
                    </div>
                    <div class="col-md-12 mt-3">
                      <textarea
                        class="form-control"
                        placeholder="Ghi chú đơn hàng (tùy chọn)"
                        id="orderNotes"
                        name="orderNotes"
                        rows="2"
                      ></textarea>
                    </div>
                  </div>
                </form>
              </div>
            </div>
          </div>
          <div class="col-lg-4">
            <div class="checkout-inner">
              <div class="checkout-summary">
                <h1>Tổng Giỏ Hàng</h1>
                <% if (cartItems && cartItems.length > 0) { %> <%
                cartItems.forEach(function(item, index) { %>
                <div
                  class="cart-item"
                  data-price="<%= item.priceProduct * item.quantity %>"
                  data-item-id="<%= item.idProduct %>"
                >
                  <label class="cart-item-label">
                    <input
                      type="checkbox"
                      class="item-checkbox"
                      checked
                      data-price="<%= item.priceProduct * item.quantity %>"
                      data-cart-id="<%= item.idCart %>"
                    />
                    <span class="cart-item-text">
                      <%= item.nameProduct %> x <%= item.quantity %><span
                        class="item-price"
                        ><%= (item.priceProduct *
                        item.quantity).toLocaleString('vi-VN') %> đ</span
                      >
                    </span>
                  </label>
                </div>
                <% }); %> <% } else { %>
                <p>Giỏ hàng trống</p>
                <% } %>
                <p class="sub-total">
                  Tạm tính<span class="subtotal-amount"
                    ><%= (cartTotal || 0).toLocaleString('vi-VN') %> đ</span
                  >
                </p>
                <p class="ship-cost">Phí ship<span>30.000 đ</span></p>
                <h2>
                  Tổng cộng<span class="total-amount"
                    ><%= ((cartTotal || 0) + 30000).toLocaleString('vi-VN') %>
                    đ</span
                  >
                </h2>
              </div>

              <div class="checkout-payment">
                <div class="payment-methods">
                  <h1>Phương thức thanh toán</h1>
                  <div class="payment-method">
                    <div class="custom-control custom-radio">
                      <input
                        type="radio"
                        class="custom-control-input"
                        id="payment-1"
                        name="payment"
                      />
                      <label class="custom-control-label" for="payment-1"
                        >Paypal</label
                      >
                    </div>
                    <div class="payment-content" id="payment-1-show">
                      <p>Đang cập nhật...</p>
                    </div>
                  </div>
                  <div class="payment-method">
                    <div class="custom-control custom-radio">
                      <input
                        type="radio"
                        class="custom-control-input"
                        id="payment-2"
                        name="payment"
                        value="COD"
                        checked
                      />
                      <label class="custom-control-label" for="payment-2"
                        >Ship COD (Thanh toán khi nhận hàng)</label
                      >
                    </div>
                    <div class="payment-content" id="payment-2-show">
                      <p>
                        ✅ Bạn sẽ thanh toán tiền mặt khi nhận được hàng. Phí
                        ship: 30,000đ
                      </p>
                    </div>
                  </div>
                  <div class="payment-method">
                    <div class="custom-control custom-radio">
                      <input
                        type="radio"
                        class="custom-control-input"
                        id="payment-5"
                        name="payment"
                      />
                      <label class="custom-control-label" for="payment-5"
                        >Chuyển khoản ngân hàng</label
                      >
                    </div>
                    <div class="payment-content" id="payment-5-show">
                      <p>Đang cập nhật...</p>
                    </div>
                  </div>
                </div>
                <div class="checkout-btn">
                  <button
                    type="button"
                    onclick="processCODOrder()"
                    id="checkoutButton"
                  >
                    <i class="fa fa-shopping-cart"></i> Đặt Hàng COD
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Checkout End -->

    <!-- Footer Start -->
