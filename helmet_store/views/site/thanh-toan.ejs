      <div class="container-fluid">
        <div class="row">
          <div class="col-lg-3 col-md-6">
            <div class="footer-widget">
              <h2>Liên Hệ</h2>
              <div class="contact-info">
                <p><i class="fa fa-map-marker"></i>Hà Nội, Việt Nam</p>
                <p><i class="fa fa-envelope"></i>tranhuy@gmail.com</p>
                <p><i class="fa fa-phone"></i>+01234567890</p>
              </div>
            </div>
          </div>

          <div class="col-lg-3 col-md-6">
            <div class="footer-widget">
              <h2>Theo Dõi Tôi</h2>
              <div class="contact-info">
                <div class="social">
                  <a href=""><i class="fab fa-twitter"></i></a>
                  <a href="https://www.facebook.com/ybx1802"
                    ><i class="fab fa-facebook-f"></i
                  ></a>
                  <a href="https://www.linkedin.com/in/huy-tran-57777b202/"
                    ><i class="fab fa-linkedin-in"></i
                  ></a>
                  <a href="#"><i class="fab fa-instagram"></i></a>
                  <a href="#"><i class="fab fa-youtube"></i></a>
                </div>
              </div>
            </div>
          </div>

          <div class="col-lg-3 col-md-6">
            <div class="footer-widget">
              <h2>Thông Tin Cửa Hàng</h2>
              <ul>
                <li><a href="#">Giới thiệu</a></li>
                <li><a href="#">Chính sách bảo mật</a></li>
                <li><a href="#">Hình thức vận chuyển</a></li>
              </ul>
            </div>
          </div>

          <div class="col-lg-3 col-md-6">
            <div class="footer-widget">
              <h2>Thông Tin Mua Hàng</h2>
              <ul>
                <li><a href="#">Chính sách thanh toán</a></li>
                <li><a href="#">Chính sách vận chuyển</a></li>
                <li><a href="#">Chính sách hoàn trả</a></li>
              </ul>
            </div>
          </div>
        </div>

        <div class="row payment align-items-center">
          <div class="col-md-6">
            <div class="payment-method">
              <h2>Nhận thanh toán bằng:</h2>
              <img src="img/payment-method.png" alt="Payment Method" />
            </div>
          </div>
          <div class="col-md-6">
            <div class="payment-security">
              <h2>Chứng chỉ bảo mật:</h2>
              <img src="img/godaddy.svg" alt="Payment Security" />
              <img src="img/norton.svg" alt="Payment Security" />
              <img src="img/ssl.svg" alt="Payment Security" />
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Footer End -->

    <!-- Footer Bottom Start -->
    <div class="footer-bottom">
      <div class="container">
        <div class="row">
          <div class="col-md-6 copyright">
            <p>
              Copyright &copy;
              <a href="https://www.facebook.com/tran.huy.928441">Helmet Store</a
              >. All Rights Reserved
            </p>
          </div>
        </div>
      </div>
    </div>
    <!-- Footer Bottom End -->

    <!-- Back to Top -->
    <a href="#" class="back-to-top"><i class="fa fa-chevron-up"></i></a>

    <!-- JavaScript Libraries -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.bundle.min.js"></script>
    <script src="lib/easing/easing.min.js"></script>
    <script src="lib/slick/slick.min.js"></script>

    <!-- Template Javascript -->
    <script src="js/main.js"></script>
    <script>
      // Function để load địa chỉ mặc định
      function loadDefaultAddress() {
        <% if (user) { %>
          $.ajax({
            url: '/users/default-address/<%= user.id %>',
            method: 'GET',
            success: function(response) {
              if (response.success && response.address) {
                let address = response.address;

                // Điền thông tin vào form
                if (address.fullName) {
                  let names = address.fullName.split(' ');
                  if (names.length >= 2) {
                    $('#firstName').val(names[0]);
                    $('#lastName').val(names.slice(1).join(' '));
                  } else {
                    $('#firstName').val(address.fullName);
                  }
                }

                if (address.phone) {
                  $('#phone').val(address.phone);
                }

                if (address.detailAddress) {
                  $('#shippingAddress').val(address.detailAddress);
                } else if (address.province) {
                  // Nếu có thông tin chi tiết về tỉnh/huyện/xã
                  let fullAddress = `${address.detailAddress || ''}, ${address.ward || ''}, ${address.district || ''}, ${address.province || ''}`.replace(/^,\s*/, '').replace(/,\s*,/g, ',');
                  $('#shippingAddress').val(fullAddress);
                }

                alert('Đã điền thông tin từ địa chỉ mặc định!');
              } else {
                alert('Không tìm thấy địa chỉ mặc định. Vui lòng thêm địa chỉ trong trang tài khoản.');
              }
            },
            error: function() {
              alert('Có lỗi xảy ra khi tải địa chỉ');
            }
          });
        <% } else { %>
          alert('Vui lòng đăng nhập để sử dụng tính năng này');
        <% } %>
      }

      // Validation form checkout
      $(document).ready(function() {
        // Function để tính lại tổng tiền theo checkbox
        function updateTotal() {
          let subtotal = 0;
          $('.item-checkbox:checked').each(function() {
            subtotal += parseInt($(this).data('price'));
          });

          let shipping = 30000;
          let total = subtotal + shipping;

          $('.subtotal-amount').text(subtotal.toLocaleString('vi-VN') + ' đ');
          $('.total-amount').text(total.toLocaleString('vi-VN') + ' đ');
        }

        // Lắng nghe sự kiện thay đổi checkbox
        $('.item-checkbox').on('change', function() {
          updateTotal();
        });

        $('#checkoutForm').on('submit', function(e) {
          // Kiểm tra có ít nhất 1 sản phẩm được chọn
          if ($('.item-checkbox:checked').length === 0) {
            e.preventDefault();
            alert('Vui lòng chọn ít nhất một sản phẩm để thanh toán');
            return false;
          }

          let firstName = $('#firstName').val().trim();
          let lastName = $('#lastName').val().trim();
          let email = $('#email').val().trim();
          let phone = $('#phone').val().trim();
          let address = $('#shippingAddress').val().trim();

          if (!firstName || !lastName || !email || !phone || !address) {
            e.preventDefault();
            alert('Vui lòng điền đầy đủ thông tin bắt buộc');
            return false;
          }

          // Validate email
          let emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (!emailRegex.test(email)) {
            e.preventDefault();
            alert('Email không hợp lệ');
            return false;
          }

          // Validate phone
          let phoneRegex = /^[0-9]{10,11}$/;
          if (!phoneRegex.test(phone)) {
            e.preventDefault();
            alert('Số điện thoại không hợp lệ');
            return false;
          }
        });
      });

      // Xử lý đặt hàng COD
      function processCODOrder() {
        // Debug: log toàn bộ HTML của checkboxes
        $('.item-checkbox').each(function(index) {
          console.log(`Checkbox ${index}:`, this.outerHTML);
        });

        // Kiểm tra có sản phẩm được chọn không
        const selectedItems = [];
        $('.item-checkbox:checked').each(function() {
          const cartId = this.getAttribute('data-cart-id');
          console.log('Found checked checkbox with cart-id:', cartId);
          if (cartId) {
            selectedItems.push(parseInt(cartId));
          }
        });

        console.log('Selected items:', selectedItems);
        console.log('Total checkboxes found:', $('.item-checkbox').length);
        console.log('Checked checkboxes found:', $('.item-checkbox:checked').length);

        if (selectedItems.length === 0) {
          alert('Vui lòng chọn ít nhất một sản phẩm để đặt hàng. Debug: Tổng checkbox: ' + $('.item-checkbox').length + ', Đã check: ' + $('.item-checkbox:checked').length);
          return;
        }

        // Lấy thông tin giao hàng
        const customerName = $('#firstName').val().trim() + ' ' + $('#lastName').val().trim();
        const customerPhone = $('#phone').val().trim();
        const email = $('#email').val().trim();
        const address = $('#shippingAddress').val().trim();
        const orderNotes = $('#orderNotes').val().trim();

        // Validate form
        if (!customerName.trim() || !customerPhone || !email || !address) {
          alert('Vui lòng điền đầy đủ thông tin giao hàng');
          return;
        }

        // Validate email
        let emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(email)) {
          alert('Email không hợp lệ');
          return;
        }

        // Validate phone
        let phoneRegex = /^[0-9]{10,11}$/;
        if (!phoneRegex.test(customerPhone)) {
          alert('Số điện thoại không hợp lệ (10-11 số)');
          return;
        }

        // Disable button và hiển thị loading
        const $button = $('#checkoutButton');
        const originalText = $button.html();
        $button.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Đang xử lý...');

        // Prepare request data
        const requestData = {
          selectedItems: selectedItems,
          customerName: customerName,
          customerPhone: customerPhone,
          shippingAddress: address,
          orderNotes: orderNotes
        };

        console.log('Sending COD request:', requestData);

        // Gửi đơn hàng
        $.ajax({
          url: '/orders/create-cod',
          method: 'POST',
          contentType: 'application/json',
          data: JSON.stringify(requestData),
          success: function(response) {
            console.log('COD response success:', response);
            if (response.success) {
              alert('✅ ' + response.message);
              // Chuyển đến trang đơn hàng hoặc trang cảm ơn
              window.location.href = '/users/tai-khoan#orders-tab';
            } else {
              alert('❌ ' + response.message);
              $button.prop('disabled', false).html(originalText);
            }
          },
          error: function(xhr, status, error) {
            console.error('COD request failed:', xhr.responseText, status, error);
            alert('Có lỗi xảy ra khi đặt hàng. Chi tiết: ' + (xhr.responseText || error));
            $button.prop('disabled', false).html(originalText);
          }
        });
      }

      // Load địa chỉ mặc định từ tài khoản
      function loadDefaultAddress() {
        // Chỉ thực hiện nếu người dùng đã đăng nhập
        <% if (user) { %>
        $.ajax({
          url: '/users/get-default-address',
          method: 'GET',
          success: function(response) {
            if (response.success && response.address) {
              const addr = response.address;
              $('#firstName').val('<%= user.ho || "" %>');
              $('#lastName').val('<%= user.ten || "" %>');
              $('#phone').val(addr.phone || '<%= user.phone || "" %>');
              $('#email').val('<%= user.email || "" %>');
              $('#shippingAddress').val(addr.detailAddress + ', ' + addr.ward + ', ' + addr.district + ', ' + addr.province);

              alert('Đã tải địa chỉ mặc định!');
            } else {
              alert('Chưa có địa chỉ mặc định. Vui lòng nhập thông tin.');
            }
          },
          error: function() {
            alert('Có lỗi khi tải địa chỉ mặc định');
          }
        });
        <% } %>
      }
    </script>
  </body>
</html>
