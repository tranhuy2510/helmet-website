<script>
  const xuLyDuLieu = (data, id) => {
    const sp_theo_loai = document.getElementById("myTable");
    let str = ``;
    for (i in data) {
      let product = data[i];
      console.log(product);
      let newName = replaceNameProduct(product.nameProduct).toLowerCase();

      str += `<div class="col-md-4">
                <div class="product-item">
                    <div class="product-title">
                        <a class="slug" href="/san-pham/${newName}">${
        product.nameProduct
      }</a>
                        <div class="ratting">
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                            <i class="fa fa-star"></i>
                        </div>
                    </div>
                    <div class="product-image">
                        <a href="/san-pham/${replaceNameProduct(
                          product.nameProduct
                        )}">
                            <img src="../${
                              product.imgProduct
                            }" alt="Product Image" width="100%">
                        </a>
              <div class="product-action" data-product-id="${
                product.idProduct
              }">
                  <a href="#" class="add-to-cart" data-product-id="${
                    product.idProduct
                  }"><i class="fa fa-cart-plus"></i></a>
                  <a href="#" class="add-to-wishlist" data-product-id="${
                    product.idProduct
                  }"><i class="${
                    window.userWishlistIds && window.userWishlistIds.includes(product.idProduct) ? 'fas' : 'far'
                  } fa-heart"></i></a>
                  <a href="/san-pham/${replaceNameProduct(
                    product.nameProduct
                  ).toLowerCase()}"><i class="fa fa-search"></i></a>
                </div>
                    </div>
                    <div class="product-price">
                        <h3>${product.priceProduct.toLocaleString(
                          "vi-VN"
                        )}<span> ₫</span></h3>
                        <a class="btn add-to-cart" href="#" data-product-id="${
                          product.idProduct
                        }"><i class="fa fa-shopping-cart"></i>Mua Ngay</a>
                    </div>
                </div>
            </div>`;
    }
    sp_theo_loai.innerHTML += str;

    // Reinitialize search/filter after data is loaded
    setTimeout(function () {
      initializeProductFilters();
    }, 100);
  };

  function initializeProductFilters() {
    // Reattach event listeners for dynamically loaded content
    $("#myInput")
      .off("keyup")
      .on("keyup", function () {
        var value = $(this).val().toLowerCase();
        $("#myTable .col-md-4").filter(function () {
          $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
        });
      });

    console.log(
      "Product filters initialized for",
      $("#myTable .col-md-4").length,
      "products"
    );
  }

  // Load products immediately when page loads
  document.addEventListener('DOMContentLoaded', function() {
    const listPro = <%- JSON.stringify(listPro) %>;
    const userWishlistIds = <%- JSON.stringify(userWishlistIds || []) %>;
    
    console.log('listPro:', listPro);
    console.log('userWishlistIds:', userWishlistIds);
    
    // Make userWishlistIds available globally for the template
    window.userWishlistIds = userWishlistIds;
    
    xuLyDuLieu(listPro);
  });

  // Keep the old fetch logic as fallback
  var paramsString = window.location.href;
  var index = paramsString.lastIndexOf("/") + 1;
  console.log(index);
  var ten_danh_muc = paramsString.slice(index);
  console.log(ten_danh_muc);

  // Fallback: fetch from API if no data from server
  /*
  window
    .fetch(`http://localhost:3000/danh-muc/api/${ten_danh_muc}`)
    .then((res) => {
      return res.json();
    })
    .then((data) => {
      console.log(data);
      xuLyDuLieu(data);
    })
    .catch((err) => {
      console.log(err);
    });
  */

  function xoa_dau(str) {
    str = str.replace(/à|á|ạ|ả|ã|â|ầ|ấ|ậ|ẩ|ẫ|ă|ằ|ắ|ặ|ẳ|ẵ/g, "a");
    str = str.replace(/è|é|ẹ|ẻ|ẽ|ê|ề|ế|ệ|ể|ễ/g, "e");
    str = str.replace(/ì|í|ị|ỉ|ĩ/g, "i");
    str = str.replace(/ò|ó|ọ|ỏ|õ|ô|ồ|ố|ộ|ổ|ỗ|ơ|ờ|ớ|ợ|ở|ỡ/g, "o");
    str = str.replace(/ù|ú|ụ|ủ|ũ|ư|ừ|ứ|ự|ử|ữ/g, "u");
    str = str.replace(/ỳ|ý|ỵ|ỷ|ỹ/g, "y");
    str = str.replace(/đ/g, "d");
    str = str.replace(/À|Á|Ạ|Ả|Ã|Â|Ầ|Ấ|Ậ|Ẩ|Ẫ|Ă|Ằ|Ắ|Ặ|Ẳ|Ẵ/g, "a");
    str = str.replace(/È|É|Ẹ|Ẻ|Ẽ|Ê|Ề|Ế|Ệ|Ể|Ễ/g, "e");
    str = str.replace(/Ì|Í|Ị|Ỉ|Ĩ/g, "i");
    str = str.replace(/Ò|Ó|Ọ|Ỏ|Õ|Ô|Ồ|Ố|Ộ|Ổ|Ỗ|Ơ|Ờ|Ớ|Ợ|Ở|Ỡ/g, "o");
    str = str.replace(/Ù|Ú|Ụ|Ủ|Ũ|Ư|Ừ|Ứ|Ự|Ử|Ữ/g, "u");
    str = str.replace(/Ỳ|Ý|Ỵ|Ỷ|Ỹ/g, "y");
    str = str.replace(/Đ/g, "d");
    str = str.split(" ").join("-");
    return str;
  }

  function replaceNameProduct(nameProduct) {
    var newNameProduct = xoa_dau(nameProduct);
    return newNameProduct;
  }

  // Search Product - sửa lại để hoạt động với dynamic content
  var searchFunction;
  var sortFunction;
  var filterFunction;

  $(document).ready(function () {
    // Search functionality
    $("#myInput").on("keyup", function () {
      var value = $(this).val().toLowerCase();
      $("#myTable .col-md-4").filter(function () {
        $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
      });
    });

    // Sort functionality
    $(".product-short .dropdown-item").on("click", function (e) {
      e.preventDefault();
      var sortType = $(this).text();
      sortProducts(sortType);
      $(".product-short .dropdown-toggle").text(sortType);
    });

    // Price filter functionality
    $(".product-price-range .dropdown-item").on("click", function (e) {
      e.preventDefault();
      var priceRange = $(this).text();
      filterByPrice(priceRange);
      $(".product-price-range .dropdown-toggle").text(priceRange);
    });
  });

  function sortProducts(sortType) {
    var container = $("#myTable");
    var products = container.children(".col-md-4").get();

    products.sort(function (a, b) {
      if (sortType === "Mới nhất") {
        return 0; // Giữ thứ tự hiện tại
      } else if (sortType === "Phổ biến" || sortType === "Bán chạy nhất") {
        return Math.random() - 0.5; // Random sort
      }
      return 0;
    });

    $.each(products, function (index, item) {
      container.append(item);
    });
  }

  function filterByPrice(priceRange) {
    var minPrice = 0;
    var maxPrice = Infinity;

    if (priceRange === "0 ₫ - 500.000 ₫") {
      minPrice = 0;
      maxPrice = 500000;
    } else if (priceRange === "500.000 ₫ - 1.000.000 ₫") {
      minPrice = 500000;
      maxPrice = 1000000;
    } else if (priceRange === "1.000.000 ₫ - 2.000.000 ₫") {
      minPrice = 1000000;
      maxPrice = 2000000;
    } else if (priceRange === "2.000.000 ₫ - 5.000.000 ₫") {
      minPrice = 2000000;
      maxPrice = 5000000;
    } else if (priceRange === "Trên 5.000.000 ₫") {
      minPrice = 5000000;
      maxPrice = Infinity;
    } else {
      // "Sắp xếp theo giá" - hiện tất cả
      $("#myTable .col-md-4").show();
      return;
    }

    $("#myTable .col-md-4").each(function () {
      var priceText = $(this).find(".product-price h3").text();
      var price = parseInt(priceText.replace(/[^\d]/g, ""));

      if (price >= minPrice && price <= maxPrice) {
        $(this).show();
      } else {
        $(this).hide();
      }
    });
  }
</script>
