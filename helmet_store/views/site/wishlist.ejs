    <!-- Wishlist Start -->
    <div class="wishlist-page">
      <div class="container-fluid">
        <div class="wishlist-page-inner">
          <div class="row">
            <div class="col-md-12">
              <div class="table-responsive">
                <table class="table table-bordered">
                  <thead class="thead-dark">
                    <tr>
                      <th>Tên sản phẩm</th>
                      <th>Giá</th>
                      <th>Số lượng</th>
                      <th>Thêm vào giỏ</th>
                      <th>Xóa</th>
                    </tr>
                  </thead>
                  <tbody class="align-middle">
                    <% if (wishlistItems && wishlistItems.length > 0) { %> <%
                    for (let item of wishlistItems) { %>
                    <tr>
                      <td>
                        <div class="img">
                          <a
                            href="/san-pham/<%= item.nameProduct.toLowerCase().replace(/\s+/g, '-').replace(/[àáạảãâầấậẩẫăằắặẳẵ]/g, 'a').replace(/[èéẹẻẽêềếệểễ]/g, 'e').replace(/[ìíịỉĩ]/g, 'i').replace(/[òóọỏõôồốộổỗơờớợởỡ]/g, 'o').replace(/[ùúụủũưừứựửữ]/g, 'u').replace(/[ỳýỵỷỹ]/g, 'y').replace(/đ/g, 'd') %>"
                            ><img src="/<%=item.imgProduct%>" alt="Image"
                          /></a>
                          <p><%=item.nameProduct%></p>
                        </div>
                      </td>
                      <td><%=item.priceProduct.toLocaleString()%> đ</td>
                      <td style="text-align: center">
                        <div
                          class="qty wishlist-qty"
                          style="
                            display: inline-flex;
                            align-items: center;
                            justify-content: center;
                            gap: 3px;
                            margin: 0 auto;
                          "
                        >
                          <button
                            class="btn-minus wishlist-btn"
                            data-product-id="<%= item.idProduct %>"
                            data-change="-1"
                            style="
                              width: 32px;
                              height: 32px;
                              border: 1px solid #007bff;
                              background: #007bff;
                              color: white;
                              border-radius: 4px;
                              display: flex;
                              align-items: center;
                              justify-content: center;
                              cursor: pointer;
                              outline: none;
                            "
                          >
                            <i
                              class="fa fa-minus"
                              style="
                                font-size: 10px;
                                color: white;
                                pointer-events: none;
                              "
                            ></i>
                          </button>
                          <input
                            type="text"
                            value="1"
                            id="qty-<%= item.idProduct %>"
                            min="1"
                            readonly
                            style="
                              width: 50px;
                              height: 32px;
                              text-align: center;
                              border: 1px solid #ddd;
                              border-radius: 4px;
                              margin: 0;
                              font-size: 14px;
                              background: white;
                              color: #333;
                              font-weight: bold;
                              box-sizing: border-box;
                              padding: 0;
                              line-height: 30px;
                            "
                          />
                          <button
                            class="btn-plus wishlist-btn"
                            data-product-id="<%= item.idProduct %>"
                            data-change="1"
                            style="
                              width: 32px;
                              height: 32px;
                              border: 1px solid #28a745;
                              background: #28a745;
                              color: white;
                              border-radius: 4px;
                              display: flex;
                              align-items: center;
                              justify-content: center;
                              cursor: pointer;
                              outline: none;
                            "
                          >
                            <i
                              class="fa fa-plus"
                              style="
                                font-size: 10px;
                                color: white;
                                pointer-events: none;
                              "
                            ></i>
                          </button>
                        </div>
                      </td>
                      <td style="text-align: center">
                        <button
                          class="btn btn-primary btn-sm move-to-cart"
                          data-product-id="<%= item.idProduct %>"
                          data-quantity="1"
                          data-size="M"
                          style="margin-bottom: 5px; width: 120px"
                        >
                          <i class="fa fa-cart-plus"></i> Thêm vào giỏ
                        </button>
                      </td>
                      <td style="text-align: center">
                        <button
                          class="btn btn-danger btn-sm"
                          data-product-id="<%= item.idProduct %>"
                          onclick="removeFromWishlist(<%= item.idProduct %>)"
                          style="width: 50px; height: 35px"
                        >
                          <i class="fa fa-trash"></i>
                        </button>
                      </td>
                    </tr>
                    <% } %> <% } else { %>
                    <tr>
                      <td colspan="5" class="text-center">
                        <p>Danh sách yêu thích trống</p>
                        <a href="/san-pham" class="btn btn-primary"
                          >Tiếp tục mua sắm</a
                        >
                      </td>
                    </tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
