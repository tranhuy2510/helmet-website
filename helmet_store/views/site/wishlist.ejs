    <!-- JavaScript Libraries -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.bundle.min.js"></script>
    <script src="lib/easing/easing.min.js"></script>
    <script src="lib/slick/slick.min.js"></script>

    <!-- Template Javascript -->
    <script src="js/main.js"></script>
    <script>
      function removeFromWishlist(productId) {
        if (
          confirm("Bạn có chắc muốn xóa sản phẩm này khỏi danh sách yêu thích?")
        ) {
          $.ajax({
            url: "/wishlist/remove",
            method: "POST",
            data: {
              idProduct: productId,
            },
            success: function (response) {
              if (response.success) {
                // Cập nhật wishlist count realtime
                updateWishlistCount(-1);
                location.reload();
              } else {
                alert(response.message);
              }
            },
            error: function () {
              alert("Lỗi khi xóa sản phẩm");
            },
          });
        }
      }

      // Function cập nhật số lượng sản phẩm trong wishlist
      function updateWishlistQuantity(productId, change) {
        var qtyInput = document.getElementById("qty-" + productId);
        if (!qtyInput) return;

        var currentQty = parseInt(qtyInput.value) || 1;
        var newQty = currentQty + change;

        if (newQty < 1) newQty = 1;
        if (newQty > 99) newQty = 99;

        qtyInput.value = newQty;

        console.log(
          `Updated quantity for product ${productId}: ${currentQty} -> ${newQty}`
        );
      }

      // Event delegation cho quantity buttons
      $(document).ready(function () {
        // Unbind any existing events để tránh duplicate
        $(document).off("click.wishlist mousedown.wishlist");

        // Sử dụng namespace và specific selector cho wishlist buttons
        $(document).on("click.wishlist", ".wishlist-btn", function (e) {
          e.preventDefault();
          e.stopImmediatePropagation();

          // Double-check để tránh multiple clicks
          if ($(this).data("processing")) {
            return false;
          }

          $(this).data("processing", true);

          var productId = $(this).data("product-id");
          var change = parseInt($(this).data("change"));

          console.log(
            `Wishlist button clicked: product ${productId}, change ${change}`
          );

          if (productId && change) {
            updateWishlistQuantity(productId, change);
          }

          // Reset processing flag sau một khoảng thời gian ngắn
          var button = $(this);
          setTimeout(function () {
            button.removeData("processing");
          }, 300);

          return false;
        });

        console.log("Wishlist quantity handlers initialized");
      });

      // Function thêm vào giỏ hàng từ wishlist
      function addToCartFromWishlist(productId) {
        var quantity = document.getElementById("qty-" + productId).value;

        $.ajax({
          url: "/cart/add",
          method: "POST",
          data: {
            idProduct: productId,
            quantity: parseInt(quantity),
            size: "M", // default size
          },
          success: function (response) {
            if (response.success) {
              // Xóa sản phẩm khỏi wishlist sau khi add to cart thành công
              $.ajax({
                url: "/wishlist/remove",
                method: "POST",
                data: {
                  idProduct: productId,
                },
                success: function (removeResponse) {
                  if (removeResponse.success) {
                    alert(
                      "Đã thêm sản phẩm vào giỏ hàng và xóa khỏi danh sách yêu thích!"
                    );
                    // Cập nhật cart count và wishlist count realtime
                    updateCartCount(parseInt(quantity));
                    updateWishlistCount(-1);
                    location.reload();
                  } else {
                    alert(
                      "Đã thêm vào giỏ hàng nhưng không thể xóa khỏi danh sách yêu thích"
                    );
                    updateCartCount(parseInt(quantity));
                  }
                },
                error: function () {
                  alert(
                    "Đã thêm vào giỏ hàng nhưng có lỗi khi xóa khỏi danh sách yêu thích"
                  );
                  updateCartCount(parseInt(quantity));
                },
              });
            } else {
              alert(response.message || "Có lỗi xảy ra");
            }
          },
          error: function () {
            alert("Lỗi khi thêm sản phẩm vào giỏ hàng");
          },
        });
      }

      // Function cập nhật wishlist count realtime
      function updateWishlistCount(change) {
        const wishlistCountElem = document.querySelector(".wishlist span");
        if (wishlistCountElem) {
          const currentCount = parseInt(
            wishlistCountElem.textContent.match(/\d+/)[0]
          );
          const newCount = Math.max(0, currentCount + change);
          wishlistCountElem.textContent = `(${newCount})`;
        }
      }

      // Function cập nhật cart count realtime
      function updateCartCount(change) {
        const cartCountElem = document.querySelector(".cart span");
        if (cartCountElem) {
          const currentCount = parseInt(
            cartCountElem.textContent.match(/\d+/)[0]
          );
          const newCount = Math.max(0, currentCount + change);
          cartCountElem.textContent = `(${newCount})`;
        }
      }
    </script>
  </body>
</html>
